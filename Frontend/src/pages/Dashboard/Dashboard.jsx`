import { useEffect, useState } from 'react';
import { useNavigate, Link } from 'react-router-dom';
import {
  Briefcase,
  Clock,
  ArrowRight,
  CheckCircle,
  Circle,
  AlertCircle,
  FileText,
  LogOut
} from 'lucide-react';
import Navbar from '../../components/layout/Navbar.jsx';
import Footer from '../../components/layout/Footer.jsx';
import Loader from '../../components/common/Loader.jsx';
import ErrorMessage from '../../components/common/ErrorMessage.jsx';
import { useAuth } from '../../context/AuthContext.jsx';
import axiosInstance from '../../api/axiosInstance.js';
import styles from './Dashboard.module.css';

export default function Dashboard() {
  const { user, logoutUser } = useAuth();
  const navigate = useNavigate();
  const [applications, setApplications] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');

  useEffect(() => {
    async function fetchMyApplications() {
      try {
        const res = await axiosInstance.get('/applications/my');
        setApplications(res.data.data);
      } catch (err) {
        setError(err.response?.data?.message || 'Failed to load your applications.');
      } finally {
        setLoading(false);
      }
    }

    if (user) {
      fetchMyApplications();
    } else {
      setLoading(false);
    }
  }, [user]);

  const getStatusColor = (status) => {
    switch (status?.toLowerCase()) {
      case 'shortlisted': return { color: 'text-emerald-600', bg: 'bg-emerald-50', icon: <CheckCircle size={14} /> };
      case 'rejected': return { color: 'text-rose-600', bg: 'bg-rose-50', icon: <AlertCircle size={14} /> };
      default: return { color: 'text-amber-600', bg: 'bg-amber-50', icon: <Clock size={14} /> };
    }
  };

  if (!user) {
    return (
      <div className={styles.pageWrapper}>
        <Navbar />
        <div className={styles.authPrompt}>
          <div className={styles.promptCard}>
            <div className={styles.promptIcon}>👤</div>
            <h2>Please Sign In</h2>
            <p>You need to be logged in to view and track your applications.</p>
            <button onClick={() => navigate('/login')} className={styles.loginBtn}>Go to Login</button>
          </div>
        </div>
        <Footer />
      </div>
    );
  }

  return (
    <div className={styles.pageWrapper}>
      <Navbar />
      <main className={styles.mainContent}>
        <header className={styles.header}>
          <div>
            <h1>Welcome back, {user.email.split('@')[0]}! 👋</h1>
            <p>Track your career progress and application milestones.</p>
          </div>
          <button onClick={logoutUser} className={styles.logoutBtn}>
            <LogOut size={18} />
            <span>Logout</span>
          </button>
        </header>

        {loading ? (
          <Loader />
        ) : error ? (
          <ErrorMessage message={error} />
        ) : (
          <div className={styles.dashboardGrid}>
            <div className={styles.appsSection}>
              <div className={styles.sectionHeader}>
                <h2>My Applications</h2>
                <span className={styles.countBadge}>{applications.length} Total</span>
              </div>

              {applications.length === 0 ? (
                <div className={styles.emptyState}>
                  <FileText size={48} />
                  <p>You haven't applied to any opportunities yet.</p>
                  <Link to="/opportunities" className={styles.browseBtn}>Browse Jobs</Link>
                </div>
              ) : (
                <div className={styles.appGrid}>
                  {applications.map((app) => {
                    const statusStyle = getStatusColor(app.status || 'Pending');
                    return (
                      <div key={app.id} className={styles.appCard}>
                        <div className={styles.appCardHeader}>
                          <div className={styles.appTitle}>{app.opportunity.title}</div>
                          <div className={styles.statusBadge} style={{ backgroundColor: statusStyle.bg, color: statusStyle.color }}>
                            {statusStyle.icon}
                            <span>{app.status || 'Pending'}</span>
                          </div>
                        </div>
                        <div className={styles.appCompany}>{app.opportunity.companyName}</div>
                        <div className={styles.appMeta}>
                          <span>Submitted on {new Date(app.createdAt).toLocaleDateString()}</span>
                        </div>
                        <Link to={`/applications/${app.applicationId}`} className={styles.viewDetails}>
                          View Details <ArrowRight size={16} />
                        </Link>
                      </div>
                    );
                  })}
                </div>
              )}
            </div>

            <div className={styles.sidebar}>
              <div className={styles.resourceCard}>
                <h3>Career Tips</h3>
                <ul className={styles.resourceList}>
                  <li>Optimize your resume for AI filters.</li>
                  <li>Research the company founders before applying.</li>
                  <li>Follow up 5 days after your submission.</li>
                </ul>
              </div>
              <div className={styles.ctaCard}>
                <h3>Find More Roles</h3>
                <p>Don't stop here. There are hundreds of other startups hiring right now.</p>
                <Link to="/opportunities" className={styles.ctaBtn}>Explore Jobs</Link>
              </div>
            </div>
          </div>
        </main>
      <Footer />
    </div>
  );
}
