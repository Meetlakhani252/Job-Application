import { useState } from 'react';
import { useNavigate } from 'react-router-dom';
import { useForm } from 'react-hook-form';
import { useAuth } from '../../../context/AuthContext.jsx';
import Box from '@mui/material/Box';
import Button from '@mui/material/Button';
import TextField from '@mui/material/TextField';
import Typography from '@mui/material/Typography';
import Container from '@mui/material/Container';
import Paper from '@mui/material/Paper';
import Alert from '@mui/material/Alert';
import { Mail, Lock, ArrowRight } from 'lucide-react';
import styles from './Login.module.css';

function UserLogin() {
  const { sendOtp, verifyOtp } = useAuth();
  const navigate = useNavigate();
  const [step, setStep] = useState('email'); // 'email' or 'otp'
  const [email, setEmail] = useState('');
  const [error, setError] = useState('');
  const [loading, setLoading] = useState(false);

  const { register, handleSubmit, formState: { errors } } = useForm();

  async function onSendOtp(data) {
    setError('');
    setLoading(true);
    try {
      await sendOtp(data.email);
      setEmail(data.email);
      setStep('otp');
    } catch (err) {
      setError(err.message || 'Failed to send OTP. Please check your email.');
    } finally {
      setLoading(false);
    }
  }

  async function onVerifyOtp(data) {
    setError('');
    setLoading(true);
    try {
      await verifyOtp(email, data.otp);
      navigate('/dashboard');
    } catch (err) {
      setError(err.message || 'Invalid OTP. Please try again.');
    } finally {
      setLoading(false);
    }
  }

  return (
    <Container maxWidth="xs" className={styles.container}>
      <Paper className={styles.card} elevation={0}>
        <Box className={styles.header}>
          <Typography variant="h4" className={styles.title}>
            Welcome Back
          </Typography>
          <Typography variant="body2" className={styles.subtitle}>
            Enter your details to access your portal
          </Typography>
        </Box>

        {error && <Alert severity="error" className={styles.alert}>{error}</Alert>}

        {step === 'email' ? (
          <Box component="form" onSubmit={handleSubmit(onSendOtp)} className={styles.form}>
            <TextField
              label="Email Address"
              type="email"
              fullWidth
              variant="outlined"
              {...register('email', { required: 'Email is required' })}
              error={!!errors.email}
              helperText={errors.email?.message}
              InputProps={{
                startAdornment: <Mail size={18} className={styles.inputIcon} />,
              }}
            />
            <Button
              type="submit"
              variant="contained"
              fullWidth
              size="large"
              disabled={loading}
              className={styles.submitBtn}
            >
              {loading ? 'Sending...' : 'Send OTP'}
              <ArrowRight size={18} />
            </Button>
          </Box>
        ) : (
          <Box component="form" onSubmit={handleSubmit(onVerifyOtp)} className={styles.form}>
            <Typography variant="body2" className={styles.otpHint}>
              Verification code sent to <b>{email}</b>
            </Typography>
            <TextField
              label="6-Digit Code"
              fullWidth
              variant="outlined"
              {...register('otp', {
                required: 'Code is required',
                pattern: { value: /^\d{6}$/, message: 'Must be exactly 6 digits' }
              })}
              error={!!errors.otp}
              helperText={errors.otp?.message}
              InputProps={{
                startAdornment: <Lock size={18} className={styles.inputIcon} />,
              }}
            />
            <Button
              type="submit"
              variant="contained"
              fullWidth
              size="large"
              disabled={loading}
              className={styles.submitBtn}
            >
              {loading ? 'Verifying...' : 'Verify & Login'}
            </Button>
            <Button
              variant="text"
              fullWidth
              onClick={() => setStep('email')}
              className={styles.backBtn}
            >
              Change Email
            </Button>
          </Box>
        )}
      </Paper>
    </Container>
  );
}

export default UserLogin;
